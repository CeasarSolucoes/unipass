# =============================================================================
# UniPass — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite .env.local.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# SERVICE ROLE: ignora TODA a RLS. Só pode ser lida no servidor.
# Nunca prefixe com NEXT_PUBLIC_. Nunca importe em Client Component.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Usada só pelos testes de isolamento de tenant (tests/rls-isolation.test.ts)
# e por scripts locais. Painel > Project Settings > Database > Connection string
SUPABASE_DB_URL="postgresql://postgres:senha@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# --- Aplicação ----------------------------------------------------------------
# URL pública, usada em links de convite e redirects de auth
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- E-mail transacional (convites, moderação de foto) ------------------------
# Fase 3 do roadmap. Deixe vazio até lá.
RESEND_API_KEY=""
EMAIL_FROM="UniPass <nao-responda@exemplo.com.br>"

# --- Pagamentos (Asaas) -------------------------------------------------------
# Semana 3 do roadmap. Deixe vazio até lá.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""
